# TerraWatch NER Configuration Example
# Copy this file to .env and configure your secret credentials

# Security: Mandatory JWT secret key. Must be a secure random string in production.
SECRET_KEY=terrawatch_academic_dev_secret_key_2026_unrestricted

# Environment
ENVIRONMENT=development
DEBUG=True
DEMO_MODE=True

# Database
DATABASE_URL=sqlite:///./terrawatch.db

# Storage
MAX_UPLOAD_SIZE_MB=25

# External Weather API
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Notifications (Console default for development/academic demo)
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
