# ==============================================================================
# MDoNER LandSafe Early Warning & Landslide Risk Monitoring System in NER
# Environment Configuration
# ==============================================================================

PROJECT_NAME=MDoNER LandSafe Early Warning System
ENVIRONMENT=development
DEBUG=True
DEMO_MODE=True
API_PREFIX=/api

# JWT Authentication
SECRET_KEY=landsafe-super-secret-jwt-key-ner-sih-2026-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: SQLite local development file
# Production: postgresql://user:password@localhost:5432/landsafe_ner
DATABASE_URL=sqlite:///./landsafe.db

# Upload directory
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# Weather Service
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Notification Provider ('console', 'log', 'twilio')
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Multilingual default ('en' for English, 'hi' for Hindi)
DEFAULT_LANGUAGE=en
